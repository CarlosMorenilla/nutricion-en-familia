{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "nutricion-garmin-personal-probe",
  "main": "worker.ts",
  "compatibility_date": "2026-09-10",
  "workers_dev": true,
  "preview_urls": false,
  "send_metrics": false,
  "vars": { "PROBE_ENABLED": "false" },
  "observability": { "enabled": false },
  "durable_objects": {
    "bindings": [{ "name": "GARMIN_PROBE", "class_name": "GarminProbe" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GarminProbe"] }],
  "triggers": { "crons": [] }
}
